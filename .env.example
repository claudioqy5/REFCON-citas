# =====================================================================
# CONFIGURACIÓN DE PRODUCCIÓN — REFCON-citas SaaS
# Copiar este archivo como '.env' en el VPS y rellenar las variables.
# =====================================================================

# 1. Base de Datos (SQL Server)
# Reemplazar con una contraseña FUERTE (mínimo 8 caracteres, números, mayúsculas y símbolos)
DB_PASSWORD=TuPasswordSuperSeguraAqui2026!
DB_PORT=1433

# 2. Seguridad JWT (Backend)
# Reemplazar con una clave aleatoria larga de mínimo 64 caracteres
JWT_SECRET=CambiarPorUnaClaveSuperLargaYSecretaDeMasDe64CaracteresAleatorios123456789!

# 3. Configuración del SaaS
ADMIN_EMAIL=admin@saas.com
FRONTEND_PORT=8085

# 4. Integración con N8n (Webhook)
# URL real del trigger webhook en tu flujo de n8n
N8N_WEBHOOK_URL=https://hook.us1.make.com/tu-webhook-n8n
