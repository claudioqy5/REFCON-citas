      "parameters": {
        "jsCode": "const s0 = $('Paso 0: Inicializar').first().json.headers['set-cookie'] || [];\nconst s1 = $('Paso 1: VALIDARLOGIN').first().json.headers['set-cookie'] || [];\n\nconst map = {};\n[...s0, ...s1].forEach(c => {\n  const p = c.split(';')[0].split('=');\n  if(p.length >= 2) map[p[0].trim()] = p.slice(1).join('=').trim();\n});\n\nreturn [{ json: { cookies: Object.entries(map).map(([k,v]) => `${k}=${v}`).join('; ') } }];"
